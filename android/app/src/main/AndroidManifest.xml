<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <uses-permission android:name="android.permission.INTERNET" />
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Target 37 requires this for direct private-IP access. Never used for scanning. -->
    <uses-permission android:name="android.permission.ACCESS_LOCAL_NETWORK" />
    <application
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="false"
        android:icon="@drawable/ic_network"
        android:label="@string/app_name"
        android:networkSecurityConfig="@xml/network_security_config"
        android:supportsRtl="true"
        android:theme="@style/AppTheme">
        <activity android:name=".MainActivity" android:exported="true">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>
        <!-- Signature permission prevents arbitrary apps from triggering saved-password login.
             AOSP/OEM sign-in generally selects its own explicit system component; this is
             a compatible system-only entry point, not a promise to replace that component. -->
        <activity android:name=".CaptiveSignInActivity" android:exported="true"
            android:permission="android.permission.CONNECTIVITY_INTERNAL">
            <intent-filter>
                <action android:name="android.net.conn.CAPTIVE_PORTAL" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </activity>
    </application>
</manifest>
