<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/scroll" android:layout_width="match_parent" android:layout_height="match_parent"
    android:fillViewport="true">
    <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content"
        android:orientation="vertical" android:padding="24dp">
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/app_name" android:textSize="32sp" android:textStyle="bold"
            android:textColor="#156B59" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/subtitle" android:layout_marginBottom="24dp" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/network_label" android:textStyle="bold" />
        <TextView android:id="@+id/networkStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/checking"
            android:layout_marginBottom="16dp" android:accessibilityLiveRegion="polite" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/portal_label" android:textStyle="bold" />
        <TextView android:id="@+id/portalStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/checking"
            android:layout_marginBottom="16dp" android:accessibilityLiveRegion="polite" />
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:text="@string/account_label" android:textStyle="bold" />
        <TextView android:id="@+id/accountStatus" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:text="@string/credential_missing"
            android:layout_marginBottom="24dp" />
        <ProgressBar android:id="@+id/progress" style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent" android:layout_height="wrap_content"
            android:indeterminate="true" android:visibility="gone" />
        <Button android:id="@+id/login" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/login" />
        <Button android:id="@+id/settings" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/settings" />
        <Button android:id="@+id/grantLocalAccess" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/grant_local_access"
            android:visibility="gone" />
        <LinearLayout android:id="@+id/settingsPanel" android:layout_width="match_parent"
            android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone">
            <TextView android:id="@+id/usernameLabel" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/username" android:labelFor="@id/username" />
            <EditText android:id="@+id/username" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textNoSuggestions"
                android:maxLength="256" android:singleLine="true" android:importantForAutofill="no"
                android:saveEnabled="false" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/password" android:labelFor="@id/password" />
            <EditText android:id="@+id/password" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" android:inputType="textPassword"
                android:maxLength="4096" android:singleLine="true" android:importantForAutofill="no"
                android:saveEnabled="false" />
            <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
                android:text="@string/http_warning" android:layout_marginTop="12dp" />
            <CheckBox android:id="@+id/consent" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/http_consent"
                android:saveEnabled="false" />
            <Button android:id="@+id/save" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/save" />
            <Button android:id="@+id/clear" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/clear" />
            <Button android:id="@+id/diagnose" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/diagnostics" />
            <TextView android:id="@+id/diagnosticDetails" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:text="@string/checking" android:textIsSelectable="true" />
            <Button android:id="@+id/licenses" android:layout_width="match_parent"
                android:layout_height="wrap_content" android:minHeight="48dp" android:text="@string/licenses" />
        </LinearLayout>
        <TextView android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_marginTop="24dp" android:text="@string/experimental" />
    </LinearLayout>
</ScrollView>
